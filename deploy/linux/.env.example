# Linux legacy all-in-one deployment example. The default Windows deployment
# uses .env and deploy/windows/start-chrome.ps1 instead.
# FLOW_INTERNAL_TOKEN may be left empty: the container creates and persists a
# private token at flow-state/internal-token on first start.
FLOW_INTERNAL_TOKEN=

# Comma-separated persistent Chrome profiles. Each profile owns one browser
# process and one extension connection.
FLOW_BROWSER_PROFILES=profile-1

FLOW_COOKIE_FRESHNESS=strict
FLOW_RECAPTCHA=broker
FLOW_SERVICE_WORKERS=8
FLOW_SCREEN_SIZE=1280x800x24

# Both ports bind to host loopback by default.
FLOW_API_HOST_PORT=8001
FLOW_NOVNC_HOST_PORT=6080

